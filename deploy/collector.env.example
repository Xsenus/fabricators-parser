# PostgreSQL on the same VPS: Unix socket, peer authentication, OS and DB role both "fabricators".
DATABASE_URL=postgresql+psycopg://fabricators@/fabricators_registry?host=/var/run/postgresql
PLAYWRIGHT_BROWSERS_PATH=/var/lib/fabricators/browsers
# Only if an existing, explicitly authorized browser session is required:
# FABRICATORS_BROWSER_STATE=/etc/fabricators/browser-state.json
